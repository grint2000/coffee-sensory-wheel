  "claims": [
    {
      "id": "clm-000001",
      "entity_id": "farm-000001",
      "section": "history",
      "title": "1963 · 농장 매입",
      "text": "Don Alejandro Morales가 기존 Bourbon·Typica 나무가 있던 농장을 매입했다는 농장 공식 연혁이다.",
      "source_ids": [
        "src-000001"
      ],
      "applicable_period": "1963",
      "status": "source_claim",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000002",
      "entity_id": "farm-000001",
      "section": "history",
      "title": "1980 · 승계와 이름",
      "text": "아들 Dr. Fredy Morales가 이어받아 아내 Rose Mary의 이름에서 ROSMA라는 농장명을 만들었다.",
      "source_ids": [
        "src-000001"
      ],
      "applicable_period": "1980",
      "status": "source_claim",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000003",
      "entity_id": "farm-000001",
      "section": "history",
      "title": "도로·용수·습식 가공장",
      "text": "Buena Vista 공동체의 도움으로 도로를 마련했고, 약 5km 떨어진 수원의 물을 연결해 습식 가공에 사용했다고 소개한다. 건설 연도는 미상이다.",
      "source_ids": [
        "src-000001"
      ],
      "applicable_period": "연도 미상",
      "status": "source_claim",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000004",
      "entity_id": "farm-000001",
      "section": "geography",
      "title": "행정구역",
      "text": "Huehuetenango는 Departamento, San Pedro Necta는 Municipio로 확인된다. 이 화면에서는 각각 대지역과 중지역 탐색 단계에 대응한다.",
      "source_ids": [
        "src-000010"
      ],
      "applicable_period": "2025 결과 표",
      "status": "verified",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000005",
      "entity_id": "farm-000001",
      "section": "geography",
      "title": "소지역 · Caserío Buena Vista",
      "text": "2024 대회 농장 소개의 주소는 Caserío Buena Vista이다. Caserío라는 원문 단위를 보존하며, Michicoy와의 세부 포함 관계는 확인하지 못했다.",
      "source_ids": [
        "src-000003"
      ],
      "applicable_period": "2024 농장 제출 소개",
      "status": "source_claim",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000006",
      "entity_id": "farm-000001",
      "section": "geography",
      "title": "고도",
      "text": "2024 본문은 4,900–6,000ft, 2026 구조화 필드는 1,494–1,829를 제시한다. 2026 필드의 단위는 별도 기재가 없어 수치만 보존한다. 2024 카드의 단일값 1,800과 농장 전체 범위를 구분한다.",
      "source_ids": [
        "src-000003",
        "src-000009"
      ],
      "applicable_period": "2024·2026 농장 소개",
      "status": "needs_context",
      "evidence_level": "E2",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000007",
      "entity_id": "farm-000001",
      "section": "geography",
      "title": "면적",
      "text": "2024 농장 소개의 면적은 60ha이다. 전체 소유 면적인지 커피 재배 면적인지 구분되지 않아 재배면적으로 단정하지 않는다.",
      "source_ids": [
        "src-000003"
      ],
      "applicable_period": "2024 농장 제출 소개",
      "status": "needs_context",
      "evidence_level": "E2",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000008",
      "entity_id": "farm-000001",
      "section": "people",
      "title": "소유자로 소개된 인물",
      "text": "2024 소개의 Our Team은 Dr. Fredy Milton Morales Merida를 Owner로 명시한다. 현재 등기 소유자나 지분 구조까지 확인한 자료는 아니다.",
      "source_ids": [
        "src-000003"
      ],
      "applicable_period": "2024 농장 제출 소개",
      "status": "source_claim",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000009",
      "entity_id": "farm-000001",
      "section": "people",
      "title": "품질·가공 담당",
      "text": "2024 소개에서 Fredy Milton Morales de la Peña는 Q grader, Angel Alejandro Morales는 Q processing 담당으로 구분된다.",
      "source_ids": [
        "src-000003"
      ],
      "applicable_period": "2024 농장 제출 소개",
      "status": "source_claim",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000010",
      "entity_id": "farm-000001",
      "section": "people",
      "title": "농장과 수출 조직",
      "text": "Rosma Coffee Land는 Finca Rosma뿐 아니라 여러 소·중규모 농장의 커피를 수출한다고 설명한다. 그룹이 취급한 품종·가공을 Rosma 농장에 자동 귀속하지 않는다.",
      "source_ids": [
        "src-000002"
      ],
      "applicable_period": "시점 미상",
      "status": "source_claim",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000011",
      "entity_id": "farm-000001",
      "section": "varieties",
      "title": "농장 소개의 품종",
      "text": "2026 소개에 Hibrid H1, Pacamara, Gesha, SL28, Maragogype와 유지 중인 Bourbon이 나온다. 나무 수·구획·연도별 생산 비중은 미확인이다.",
      "source_ids": [
        "src-000009"
      ],
      "applicable_period": "2026 농장 제출 소개",
      "status": "source_claim",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000012",
      "entity_id": "farm-000001",
      "section": "processing",
      "title": "농장 소개의 가공",
      "text": "2024 소개에는 fully washed, red honey, yellow honey, natural drying이 기재된다. 모든 판매 로트에 이 가공법을 일괄 적용하지 않는다.",
      "source_ids": [
        "src-000003"
      ],
      "applicable_period": "2024 농장 제출 소개",
      "status": "source_claim",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000013",
      "entity_id": "farm-000001",
      "section": "processing",
      "title": "수확기와 건조",
      "text": "2024 소개는 수확기를 1–4월, 건조 장소를 직사광 파티오·아프리칸 베드·그린하우스로 제시한다. 특정 로트의 실제 수확일·건조 기간은 별도 확인이 필요하다.",
      "source_ids": [
        "src-000003"
      ],
      "applicable_period": "2024 농장 제출 소개",
      "status": "source_claim",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    },
    {
      "id": "clm-000014",
      "entity_id": "farm-000001",
      "section": "geography",
      "title": "Highland Huehue 산지 맥락",
      "text": "Anacafé는 비화산성 고지대, Tehuantepec의 따뜻하고 건조한 바람, 풍부한 하천을 이 산지의 특징으로 설명한다. 이 설명만으로 Rosma 로트의 컵노트를 만들지 않는다.",
      "source_ids": [
        "src-000011"
      ],
      "applicable_period": "게시 시점 미상",
      "status": "source_claim",
      "evidence_level": "E1",
      "verified_at": "2026-10-01",
      "fictional": false,
      "supersedes": null
    }
  ],
